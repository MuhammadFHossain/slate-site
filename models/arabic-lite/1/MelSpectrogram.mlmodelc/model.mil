program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3605.1.1"}, {"coremlc-version", "3600.25.1"}, {"coremltools-component-torch", "2.7.1"}, {"coremltools-source-dialect", "TorchScript"}, {"coremltools-version", "8.3.0"}})]
{
    func main<ios18>(tensor<fp32, [1, 240000]> audio, tensor<int32, [1]> audio_length) {
            tensor<fp32, [80, 257]> fb = const()[name = string("fb"), val = tensor<fp32, [80, 257]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64)))];
            tensor<fp32, [514, 1, 512]> basis = const()[name = string("basis"), val = tensor<fp32, [514, 1, 512]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(82368)))];
            string cast_0_dtype_0 = const()[name = string("cast_0_dtype_0"), val = string("fp32")];
            tensor<int32, [2]> var_35_begin_0 = const()[name = string("op_35_begin_0"), val = tensor<int32, [2]>([0, 0])];
            tensor<int32, [2]> var_35_end_0 = const()[name = string("op_35_end_0"), val = tensor<int32, [2]>([1, 1])];
            tensor<bool, [2]> var_35_end_mask_0 = const()[name = string("op_35_end_mask_0"), val = tensor<bool, [2]>([true, false])];
            tensor<fp32, [1, 1]> var_35 = slice_by_index(begin = var_35_begin_0, end = var_35_end_0, end_mask = var_35_end_mask_0, x = audio)[name = string("op_35")];
            tensor<int32, [2]> var_45_begin_0 = const()[name = string("op_45_begin_0"), val = tensor<int32, [2]>([0, 1])];
            tensor<int32, [2]> var_45_end_0 = const()[name = string("op_45_end_0"), val = tensor<int32, [2]>([1, 240000])];
            tensor<bool, [2]> var_45_end_mask_0 = const()[name = string("op_45_end_mask_0"), val = tensor<bool, [2]>([true, true])];
            tensor<fp32, [1, 239999]> var_45 = slice_by_index(begin = var_45_begin_0, end = var_45_end_0, end_mask = var_45_end_mask_0, x = audio)[name = string("op_45")];
            tensor<int32, [2]> var_55_begin_0 = const()[name = string("op_55_begin_0"), val = tensor<int32, [2]>([0, 0])];
            tensor<int32, [2]> var_55_end_0 = const()[name = string("op_55_end_0"), val = tensor<int32, [2]>([1, 239999])];
            tensor<bool, [2]> var_55_end_mask_0 = const()[name = string("op_55_end_mask_0"), val = tensor<bool, [2]>([true, false])];
            tensor<fp32, [1, 239999]> var_55 = slice_by_index(begin = var_55_begin_0, end = var_55_end_0, end_mask = var_55_end_mask_0, x = audio)[name = string("op_55")];
            fp32 var_56 = const()[name = string("op_56"), val = fp32(0x1.f0a3d8p-1)];
            tensor<fp32, [1, 239999]> var_57 = mul(x = var_55, y = var_56)[name = string("op_57")];
            tensor<fp32, [1, 239999]> var_59 = sub(x = var_45, y = var_57)[name = string("op_59")];
            int32 var_61 = const()[name = string("op_61"), val = int32(1)];
            bool x_1_interleave_0 = const()[name = string("x_1_interleave_0"), val = bool(false)];
            tensor<fp32, [1, 240000]> x_1 = concat(axis = var_61, interleave = x_1_interleave_0, values = (var_35, var_59))[name = string("x_1")];
            tensor<int32, [1]> var_69_axes_0 = const()[name = string("op_69_axes_0"), val = tensor<int32, [1]>([1])];
            tensor<fp32, [1]> cast_0 = cast(dtype = cast_0_dtype_0, x = audio_length)[name = string("cast_11")];
            tensor<fp32, [1, 1]> var_69 = expand_dims(axes = var_69_axes_0, x = cast_0)[name = string("op_69")];
            tensor<fp32, [1, 240000]> steps_promoted = const()[name = string("steps_promoted"), val = tensor<fp32, [1, 240000]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(1135104)))];
            tensor<bool, [1, 240000]> var_70 = less(x = steps_promoted, y = var_69)[name = string("op_70")];
            tensor<fp32, [1, 240000]> var_76 = const()[name = string("op_76"), val = tensor<fp32, [1, 240000]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(2095168)))];
            tensor<fp32, [1, 240000]> x_3 = select(a = x_1, b = var_76, cond = var_70)[name = string("x_3")];
            tensor<int32, [1]> var_84_axes_0 = const()[name = string("op_84_axes_0"), val = tensor<int32, [1]>([1])];
            tensor<fp32, [1, 1, 240000]> var_84 = expand_dims(axes = var_84_axes_0, x = x_3)[name = string("op_84")];
            fp32 const_3 = const()[name = string("const_3"), val = fp32(0x0p+0)];
            tensor<int32, [6]> x_5_pad_0 = const()[name = string("x_5_pad_0"), val = tensor<int32, [6]>([0, 0, 0, 0, 256, 256])];
            string x_5_mode_0 = const()[name = string("x_5_mode_0"), val = string("constant")];
            tensor<fp32, [1, 1, 240512]> x_5 = pad(constant_val = const_3, mode = x_5_mode_0, pad = x_5_pad_0, x = var_84)[name = string("x_5")];
            string spec_pad_type_0 = const()[name = string("spec_pad_type_0"), val = string("valid")];
            tensor<int32, [1]> spec_strides_0 = const()[name = string("spec_strides_0"), val = tensor<int32, [1]>([160])];
            tensor<int32, [2]> spec_pad_0 = const()[name = string("spec_pad_0"), val = tensor<int32, [2]>([0, 0])];
            tensor<int32, [1]> spec_dilations_0 = const()[name = string("spec_dilations_0"), val = tensor<int32, [1]>([1])];
            int32 spec_groups_0 = const()[name = string("spec_groups_0"), val = int32(1)];
            tensor<fp32, [1, 514, 1501]> spec = conv(dilations = spec_dilations_0, groups = spec_groups_0, pad = spec_pad_0, pad_type = spec_pad_type_0, strides = spec_strides_0, weight = basis, x = x_5)[name = string("spec")];
            tensor<int32, [3]> real_begin_0 = const()[name = string("real_begin_0"), val = tensor<int32, [3]>([0, 0, 0])];
            tensor<int32, [3]> real_end_0 = const()[name = string("real_end_0"), val = tensor<int32, [3]>([1, 257, 1501])];
            tensor<bool, [3]> real_end_mask_0 = const()[name = string("real_end_mask_0"), val = tensor<bool, [3]>([true, false, true])];
            tensor<fp32, [1, 257, 1501]> real = slice_by_index(begin = real_begin_0, end = real_end_0, end_mask = real_end_mask_0, x = spec)[name = string("real")];
            tensor<int32, [3]> imag_begin_0 = const()[name = string("imag_begin_0"), val = tensor<int32, [3]>([0, 257, 0])];
            tensor<int32, [3]> imag_end_0 = const()[name = string("imag_end_0"), val = tensor<int32, [3]>([1, 514, 1501])];
            tensor<bool, [3]> imag_end_mask_0 = const()[name = string("imag_end_mask_0"), val = tensor<bool, [3]>([true, true, true])];
            tensor<fp32, [1, 257, 1501]> imag = slice_by_index(begin = imag_begin_0, end = imag_end_0, end_mask = imag_end_mask_0, x = spec)[name = string("imag")];
            tensor<fp32, [1, 257, 1501]> var_132 = mul(x = real, y = real)[name = string("op_132")];
            tensor<fp32, [1, 257, 1501]> var_133 = mul(x = imag, y = imag)[name = string("op_133")];
            tensor<fp32, [1, 257, 1501]> var_135 = add(x = var_132, y = var_133)[name = string("op_135")];
            bool var_136_transpose_x_0 = const()[name = string("op_136_transpose_x_0"), val = bool(false)];
            bool var_136_transpose_y_0 = const()[name = string("op_136_transpose_y_0"), val = bool(false)];
            tensor<fp32, [1, 80, 1501]> var_136 = matmul(transpose_x = var_136_transpose_x_0, transpose_y = var_136_transpose_y_0, x = fb, y = var_135)[name = string("op_136")];
            fp32 var_138 = const()[name = string("op_138"), val = fp32(0x1p-24)];
            tensor<fp32, [1, 80, 1501]> var_139 = add(x = var_136, y = var_138)[name = string("op_139")];
            fp32 x_epsilon_0 = const()[name = string("x_epsilon_0"), val = fp32(0x1p-149)];
            tensor<fp32, [1, 80, 1501]> x = log(epsilon = x_epsilon_0, x = var_139)[name = string("x")];
            fp32 _inversed_142_y_0 = const()[name = string("_inversed_142_y_0"), val = fp32(0x1.99999ap-8)];
            tensor<fp32, [1]> _inversed_142 = mul(x = cast_0, y = _inversed_142_y_0)[name = string("_inversed_142")];
            tensor<fp32, [1]> frames = floor(x = _inversed_142)[name = string("frames")];
            tensor<int32, [1]> var_166_axes_0 = const()[name = string("op_166_axes_0"), val = tensor<int32, [1]>([1])];
            tensor<fp32, [1, 1]> var_166 = expand_dims(axes = var_166_axes_0, x = frames)[name = string("op_166")];
            tensor<fp32, [1, 1501]> var_159_promoted = const()[name = string("op_159_promoted"), val = tensor<fp32, [1, 1501]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(3055232)))];
            tensor<bool, [1, 1501]> var_167 = less(x = var_159_promoted, y = var_166)[name = string("op_167")];
            tensor<int32, [1]> var_174_axes_0 = const()[name = string("op_174_axes_0"), val = tensor<int32, [1]>([1])];
            tensor<bool, [1, 1, 1501]> var_174 = expand_dims(axes = var_174_axes_0, x = var_167)[name = string("op_174")];
            tensor<fp32, [1, 80, 1501]> var_192 = const()[name = string("op_192"), val = tensor<fp32, [1, 80, 1501]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(3061312)))];
            tensor<int32, [3]> valid_after_broadcast_reps_0 = const()[name = string("valid_after_broadcast_reps_0"), val = tensor<int32, [3]>([1, 80, 1])];
            tensor<bool, [1, 80, 1501]> valid_after_broadcast = tile(reps = valid_after_broadcast_reps_0, x = var_174)[name = string("valid_after_broadcast")];
            tensor<fp32, [1, 80, 1501]> var_193 = select(a = x, b = var_192, cond = valid_after_broadcast)[name = string("op_193")];
            tensor<int32, [1]> var_198_axes_0 = const()[name = string("op_198_axes_0"), val = tensor<int32, [1]>([2])];
            bool var_198_keep_dims_0 = const()[name = string("op_198_keep_dims_0"), val = bool(false)];
            tensor<fp32, [1, 80]> var_198 = reduce_sum(axes = var_198_axes_0, keep_dims = var_198_keep_dims_0, x = var_193)[name = string("op_198")];
            tensor<fp32, [1, 80]> mean = real_div(x = var_198, y = var_166)[name = string("mean")];
            tensor<int32, [1]> var_211_axes_0 = const()[name = string("op_211_axes_0"), val = tensor<int32, [1]>([2])];
            tensor<fp32, [1, 80, 1]> var_211 = expand_dims(axes = var_211_axes_0, x = mean)[name = string("op_211")];
            tensor<fp32, [1, 80, 1501]> var_213 = sub(x = x, y = var_211)[name = string("op_213")];
            tensor<fp32, [1, 80, 1501]> centred = select(a = var_213, b = var_192, cond = valid_after_broadcast)[name = string("centred")];
            tensor<fp32, [1, 80, 1501]> var_221 = mul(x = centred, y = centred)[name = string("op_221")];
            tensor<int32, [1]> var_226_axes_0 = const()[name = string("op_226_axes_0"), val = tensor<int32, [1]>([2])];
            bool var_226_keep_dims_0 = const()[name = string("op_226_keep_dims_0"), val = bool(false)];
            tensor<fp32, [1, 80]> var_226 = reduce_sum(axes = var_226_axes_0, keep_dims = var_226_keep_dims_0, x = var_221)[name = string("op_226")];
            fp32 var_228_promoted = const()[name = string("op_228_promoted"), val = fp32(0x1p+0)];
            tensor<fp32, [1, 1]> var_229 = sub(x = var_166, y = var_228_promoted)[name = string("op_229")];
            tensor<fp32, [1, 80]> var_230 = real_div(x = var_226, y = var_229)[name = string("op_230")];
            tensor<fp32, [1, 80]> var_231 = sqrt(x = var_230)[name = string("op_231")];
            fp32 var_233 = const()[name = string("op_233"), val = fp32(0x1.4f8b58p-17)];
            tensor<fp32, [1, 80]> std = add(x = var_231, y = var_233)[name = string("std")];
            tensor<int32, [1]> var_260_axes_0 = const()[name = string("op_260_axes_0"), val = tensor<int32, [1]>([2])];
            tensor<fp32, [1, 80, 1]> var_260 = expand_dims(axes = var_260_axes_0, x = std)[name = string("op_260")];
            tensor<fp32, [1, 80, 1501]> var_261 = real_div(x = var_213, y = var_260)[name = string("op_261")];
            tensor<fp32, [1, 80, 1501]> melspectrogram_features = select(a = var_261, b = var_192, cond = valid_after_broadcast)[name = string("op_268")];
            string cast_9_dtype_0 = const()[name = string("cast_9_dtype_0"), val = string("int32")];
            tensor<int32, [1]> mel_length = cast(dtype = cast_9_dtype_0, x = frames)[name = string("cast_10")];
        } -> (melspectrogram_features, mel_length);
}