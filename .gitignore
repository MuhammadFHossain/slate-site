.DS_Store

# The Sparkle private key, if it is ever exported here. It must never be public.
slate-update-key.txt
*.private

# The DMG is committed on purpose: GitHub Pages serves whatever is in the repo,
# so the download button needs the file to be here. Only ever commit a build
# that came out of `scripts/notarize.sh` and passes:
#
#   xcrun stapler validate Slate-<version>.dmg
#   spctl -a -t open --context context:primary-signature -vv Slate-<version>.dmg
#
# A development-signed build would be blocked by Gatekeeper on every Mac but
# the one that made it, and git history keeps it forever.
